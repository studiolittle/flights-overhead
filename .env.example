# Everything here is OPTIONAL. There are no API keys to configure: the app
# runs as-is.

# --- Google Analytics 4 ---
# The site's own measurement ID (G-KKW2HEXNQT) is built in and loads only in
# production builds. Set this to send data to a different GA4 property
# instead. NEXT_PUBLIC_ values are baked in at build time, so redeploy after
# changing it in Vercel.
NEXT_PUBLIC_GA_ID=

# --- Your home (used before anyone sets a postal code) ---
# The radar is centred on YOW; this is just where you are on it, and what the
# "passing overhead" alert is measured from. Defaults to YOW itself
# (see lib/config.ts).
HOME_LAT=45.3225
HOME_LON=-75.6692

# --- Radar defaults (the range presets in the UI override this) ---
# How far around the airport the radar reaches, km.
RADAR_RANGE_KM=50
# Anything within this of your home counts as "overhead": it triggers the
# alert state and the log entry.
OVERHEAD_RADIUS_KM=2.5

# --- Client refresh (optional) ---
# How often the browser pulls a fresh snapshot, in ms. Min 10000, which
# matches the server's shared 9 s snapshot. Paused while the tab is hidden.
# Between polls, aircraft are advanced by dead reckoning so the scope moves.
NEXT_PUBLIC_POLL_INTERVAL_MS=10000
