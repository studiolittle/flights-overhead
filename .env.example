# Everything here is OPTIONAL. The station is normally set in the app itself
# by typing a postal code, which is saved in your browser.

# --- Default location (used before anyone sets a postal code) ---
# Defaults to K2G 6P3 / Nepean, Ontario (see lib/config.ts). Setting these
# overrides those coordinates.
HOME_LAT=45.3286
HOME_LON=-75.7703

# --- Radar defaults (the range presets in the UI override this) ---
RADAR_RANGE_KM=10
# Anything closer than this counts as "overhead": it triggers the alert state,
# the notification, and the log entry. Scales up automatically at wider ranges.
OVERHEAD_RADIUS_KM=2.5

# --- Client refresh (optional) ---
# How often the browser pulls a fresh snapshot, in ms. Min 15000.
# Between polls, aircraft are advanced by dead reckoning so the scope moves.
NEXT_PUBLIC_POLL_INTERVAL_MS=40000

# --- OpenSky API client (optional but strongly recommended) ---
# Without these the app uses anonymous access, rate-limited to a few hundred
# requests/day per IP. Create a free API client at:
#   https://opensky-network.org/  ->  Account  ->  API clients
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
